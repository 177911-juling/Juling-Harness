    "test:built": "node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@juling-harness/client": "1.0.1",
    "@juling-harness/client-contract": "1.0.1",
    "@juling-harness/harness-host": "1.0.1",
    "@juling-harness/host-client-api": "1.0.1",
    "@juling-harness/platform": "1.0.1",
    "@juling-harness/platform-darwin": "1.0.1",
    "@juling-harness/platform-win32": "1.0.1",
    "@juling-harness/runtime-installer": "1.0.1",
    "@juling-harness/transport-desktop": "1.0.1",
    "builder-util-runtime": "9.7.0",
    "electron-updater": "6.8.9",
    "node-pty": "^1.1.0",
    "socks": "2.8.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@juling-harness/testkit": "1.0.1",
