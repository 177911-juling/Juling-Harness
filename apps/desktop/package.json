{
  "name": "@juling-harness/desktop",
  "productName": "Juling Harness",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/src/main.js",
  "author": "snowpear",
  "description": "Juling Harness desktop shell (Electron Main) for Windows, macOS and Linux",
  "scripts": {
    "dev": "electron .",
