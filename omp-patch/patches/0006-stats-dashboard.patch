diff --git a/packages/stats/src/client/i18n.ts b/packages/stats/src/client/i18n.ts
new file mode 100644
index 0000000000..cb9d984f5a
--- /dev/null
+++ b/packages/stats/src/client/i18n.ts
@@ -0,0 +1,30 @@
+/**
+ * Dashboard language.
+ *
+ * The Harness embeds this dashboard in an iframe and appends `?lang=zh` (or
+ * `?lang=en`) so the panel follows the app's interface language. Opened on its
+ * own, it falls back to the browser's primary language. English is the source
+ * language: every call site spells the English copy first and the Chinese copy
+ * second, so a missing translation can never blank a label.
+ */
+
+function detectLanguage(): "zh" | "en" {
+	// Browser-only globals; the stats bundle compiles without the DOM lib, so
+	// name the two fields this probe needs instead of an inline cast.
+	const scope = globalThis as unknown as { location?: { search?: string }; navigator?: { language?: string } };
+	const query = scope.location?.search ?? "";
+	const requested = new URLSearchParams(query).get("lang");
+	if (requested !== null) return requested.toLowerCase().startsWith("zh") ? "zh" : "en";
+	const preferred = scope.navigator?.language ?? "";
+	return preferred.toLowerCase().startsWith("zh") ? "zh" : "en";
+}
+
+export const dashboardLanguage = detectLanguage();
+
+/** True when the dashboard speaks Chinese. */
+export const zh = dashboardLanguage === "zh";
+
+/** Inline bilingual literal. `t("Overview", "总览")`. */
+export function t(en: string, chinese: string): string {
+	return zh ? chinese : en;
+}
