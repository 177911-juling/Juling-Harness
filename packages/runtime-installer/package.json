{
  "name": "@juling-harness/runtime-installer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "test:built": "node --test \"dist/test/*.test.js\""
  },
  "dependencies": {
    "@juling-harness/harness-protocol": "1.0.0",
    "fflate": "0.8.3"
  }
}
